--- a/src/app/core/auth/sso.spec.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/src/app/core/auth/sso.spec.ts	2026-10-18 23:22:25.338293600 -0300
@@ -0,0 +1,20 @@
+import { tokenDelFragmento } from './sso';
+
+describe('tokenDelFragmento', () => {
+  const token = 'aaa.bbb.ccc';
+
+  it('lee el token del fragmento', () => {
+    expect(tokenDelFragmento('#sso=' + token)).toBe(token);
+  });
+
+  it('acepta el fragmento sin la almohadilla y con otros parámetros', () => {
+    expect(tokenDelFragmento('x=1&sso=' + token)).toBe(token);
+  });
+
+  it('ignora lo que no parece un token', () => {
+    expect(tokenDelFragmento('')).toBeNull();
+    expect(tokenDelFragmento('#sso=')).toBeNull();
+    expect(tokenDelFragmento('#sso=abc')).toBeNull();
+    expect(tokenDelFragmento('#otro=' + token)).toBeNull();
+  });
+});
diff -ruN -x node_modules -x .angular -x dist a/src/app/core/auth/sso.ts b/src/app/core/auth/sso.ts
--- a/src/app/core/auth/sso.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/src/app/core/auth/sso.ts	2026-10-18 23:22:25.337295800 -0300
@@ -0,0 +1,9 @@
+// El Portal Administrativo abre este portal con la sesión en el fragmento de la dirección (#sso=<token>). Va en el fragmento
+// y no en la query para que el token no viaje al servidor ni quede en sus registros.
+export const CLAVE_FRAGMENTO = 'sso';
+
+export function tokenDelFragmento(hash: string): string | null {
+  const texto = hash.startsWith('#') ? hash.slice(1) : hash;
+  const valor = new URLSearchParams(texto).get(CLAVE_FRAGMENTO);
+  return valor && valor.split('.').length === 3 ? valor : null;
+}
